{
  "name": "chrome-translation-assistant",
  "version": "1.0.28",
  "description": "AI-powered translation assistant with multi-provider support",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "zip": "node scripts/zip-extension.js",
    "build:release": "npm run build && npm run zip",
    "version:patch": "npm version patch --no-git-tag-version && node scripts/sync-version.js",
    "version:minor": "npm version minor --no-git-tag-version && node scripts/sync-version.js",
    "version:major": "npm version major --no-git-tag-version && node scripts/sync-version.js",
    "release:local": "npm run version:patch && npm run build:release",
    "sync-version": "node scripts/sync-version.js"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "firebase": "^10.7.2",
    "katex": "^0.16.28",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.21",
    "@types/chrome": "^0.0.258",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "@vitejs/plugin-react": "^4.2.1",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.33",
    "prettier": "^3.1.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  }
}
